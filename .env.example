# Copy to .env and fill in. Never commit .env.

# Your Xtream Codes panel, exactly as your provider gave it to you
# (scheme + host + port, no trailing slash)
XC_BASE_URL=http://your-panel.example.com:8080
XC_USERNAME=your-username
XC_PASSWORD=your-password

# Random string that becomes part of your addon URL — it is the only thing
# protecting your addon, treat it like a password. Generate one with:
#   openssl rand -hex 12
ADDON_SECRET=change-me

# Shown as the addon name in Stremio and on every stream entry
ADDON_NAME=Astra

PORT=7000
